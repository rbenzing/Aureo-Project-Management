# Rules for installations where the document root IS the application root.
# The recommended layout points the document root at public/ instead, in which
# case this file is never consulted.
#
# nginx has no per-directory configuration, so none of this applies there - see
# docs/DEPLOYMENT.md for the equivalent server block.

RewriteEngine On

# Deny whole directories that must never be served. RewriteRule (not
# RedirectMatch) because mod_rewrite matches per-directory, stripping the
# install prefix - RedirectMatch anchors at ^/ and so silently does nothing
# when the app lives in a subdirectory.
#
# [NC] is load-bearing: Apache compiles <FilesMatch> case-insensitively on
# case-insensitive filesystems (Windows, default macOS), but RewriteRule stays
# case-sensitive everywhere. Without it, GET /.Git/config served the repository
# config, and /.Git/objects/** the entire history.
#
# tools/ holds a phpMyAdmin install configured with AllowNoPassword; docs/,
# .superpowers/, .github/ and .claude/ hold internal notes, source diffs and CI
# configuration. None of these are routes - see the router in public/index.php.
RewriteRule ^(\.git|\.github|\.claude|\.superpowers|db|tests|bin|node_modules|var|log|vendor|config|tools|docs)(/|$) - [F,L,NC]

# Serve real files and directories as-is; route everything else to the front
# controller.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# Deny anything that is not meant to be served. PHP class files are executed
# rather than disclosed, and every view guards on BASE_PATH, so the real risk
# is the non-PHP files here.
#
# Matched by name, not just extension:
#   ^\.            dotfiles (.env, .gitignore, .nvmrc, ...)
#   ^VERSION$      no extension, so no rule below would reach it
#   \.config\.js$  tailwind.config.js / postcss.config.js. Deliberately NOT a
#                  bare `js` extension: <FilesMatch> here applies to every
#                  subdirectory, and a bare `js` would stop serving
#                  public/assets/js/*.js in this layout.
#   config         web.config, which otherwise ships the full IIS deny list in
#                  plaintext to anyone who asks for it.
<FilesMatch "(^\.|^VERSION$|\.config\.js$|\.(env|log|sql|md|lock|json|xml|dist|yml|yaml|gz|config|diff)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
AddDefaultCharset UTF-8
ServerSignature Off
