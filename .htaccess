# Rules for installations where the document root IS the application root.
# The recommended layout points the document root at public/ instead, in which
# case this file is never consulted.
#
# nginx has no per-directory configuration, so none of this applies there - see
# docs/DEPLOYMENT.md for the equivalent server block.

RewriteEngine On

# Deny whole directories that must never be served. RewriteRule (not
# RedirectMatch) because mod_rewrite matches per-directory, stripping the
# install prefix - RedirectMatch anchors at ^/ and so silently does nothing
# when the app lives in a subdirectory.
RewriteRule ^(\.git|db|tests|bin|node_modules|var|log|vendor|config)(/|$) - [F,L]

# Serve real files and directories as-is; route everything else to the front
# controller.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# Deny anything that is not meant to be served. PHP class files are executed
# rather than disclosed, and all 97 views guard on BASE_PATH, so the real risk
# is the non-PHP files here.
<FilesMatch "(^\.|\.(env|log|sql|md|lock|json|xml|dist|yml|yaml|gz)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
AddDefaultCharset UTF-8
ServerSignature Off
