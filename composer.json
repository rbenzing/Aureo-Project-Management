{
    "name": "aureo/aureo-project-management",
    "description": "Aureo Project Management - A comprehensive project management application with user authentication, roles, and email functionality.",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "homepage": "https://github.com/rbenzing/Aureo-Project-Management",
    "support": {
        "issues": "https://github.com/rbenzing/Aureo-Project-Management/issues",
        "source": "https://github.com/rbenzing/Aureo-Project-Management"
    },
    "authors": [
        {
            "name": "Russell Benzing",
            "email": "me@russellbenzing.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "php-di/php-di": "^7.0",
        "phpmailer/phpmailer": "^6.0",
        "robmorgan/phinx": "^0.16",
        "vlucas/phpdotenv": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "friendsofphp/php-cs-fixer": "^3.15"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-install-cmd": "@php bin/install.php",
        "post-update-cmd": "@php bin/install.php",
        "start": "php -S localhost:8000 -t public",
        "install-app": "@php bin/install.php",
        "setup": "@php bin/setup.php --yes",
        "pma": "@php bin/pma.php",
        "pma:install": "@php bin/pma.php install",
        "test": "phpunit --testdox",
        "test:unit": "phpunit --testsuite Unit --testdox",
        "test:integration": "phpunit --testsuite Integration --testdox",
        "test:coverage": "phpunit --coverage-html coverage",
        "test:clover": "phpunit --coverage-clover coverage.xml",
        "coverage:gate": "@php bin/coverage-gate.php",
        "coverage:ratchet": "@php bin/coverage-gate.php --update",
        "coverage:check": [
            "@test:clover",
            "@coverage:gate"
        ],
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "migrate": "phinx migrate",
        "migrate:rollback": "phinx rollback",
        "migrate:status": "phinx status",
        "migrate:create": "phinx create"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}